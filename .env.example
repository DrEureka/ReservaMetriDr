################################################################
# ReservaMetriDr — Ejemplo de entorno
# Copialo a .env y completalo con los secretos reales.
# NUNCA commitear .env
################################################################

APP_NAME=ReservaMetriDr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locales:
#   APP_LOCALE = es  (traducciones en lang/es.json + lang/es/*.php)
#   El formato argentino de fechas/moneda se aplica dentro de app/helpers.php
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################################################
# BD — Producción MySQL (Heliohost)
# IMPORTANTE: si tu password contiene '#', ponelo entre comillas dobles
# porque dotenv lo interpreta como comentario.
################################################################
DB_CONNECTION=mysql
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Para desarrollo local sin MySQL:
# DB_CONNECTION=sqlite
# (crear database/database.sqlite vacío)

################################################################
# Sesiones / cache / cola → Redis
################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

################################################################
# Redis — Upstash con TLS
################################################################
REDIS_CLIENT=predis
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_SCHEME=tls
REDIS_URL="tls://default:your_redis_password@your-redis-host.upstash.io:6379"

################################################################
# Mail
# - smtp_relaja: SMTP sin verificación SSL estricta (útil cuando el cert
#   del host tiene CN distinto al dominio, ej: Heliohost shared).
#   Definido en AppServiceProvider::boot().
# - smtp: SMTP estándar de Laravel (verifica cert).
# - log: escribe en storage/logs/laravel.log (dev).
#
# IMPORTANTE: si tu password tiene caracteres especiales (#, ^, etc.)
# ponelo entre comillas dobles porque dotenv puede interpretarlos mal.
################################################################
MAIL_MAILER=smtp_relaja
MAIL_HOST=your-mail-host.example.com
MAIL_PORT=465
MAIL_USERNAME=your-mail-user@example.com
MAIL_PASSWORD="your_mail_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="reservas@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Para dev local sin SMTP real:
# MAIL_MAILER=log

# Para hosting con cert válido (cert CN match al dominio del mail):
# MAIL_MAILER=smtp

################################################################
# AWS (sin uso por ahora)
################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
